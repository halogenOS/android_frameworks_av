package {
    default_applicable_licenses: ["frameworks_av_services_audioflinger_license"],
}

cc_fuzz {
    name: "audioinformation_service_fuzzer",
    srcs: ["audioinformation_fuzzer.cpp"],
    defaults: [
        "libaudioflinger_dependencies",
        "service_fuzzer_defaults",
    ],
    shared_libs: [
        "libaudioflinger",
    ],
    header_libs: [
        "libaudioflinger_headers",
    ],
    fuzz_config: {
        cc: [
            "android-audio-fuzzing-reports@google.com",
        ],
        componentid: 155276,
        hotlists: ["4593311"],
        description: "The fuzzer targets the audio information service APIs",
        vector: "local_no_privileges_required",
        service_privilege: "privileged",
    },
}
